---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { useTranslations } from "../i18n/utils";

// Cloudflare Pages bulunamayan her adres için bu sayfayı 404 koduyla döner.
// Adres her dilde olabileceği için iki dilde yazılır; dil değiştirme bağlantısı gösterilmez.
const t = useTranslations("tr");
const en = useTranslations("en");
---

<BaseLayout title={t("notFound.title")} noindex translated={false}>
  <Container class="py-28">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 text-5xl">{t("notFound.title")}</h1>
    <p class="mt-4 text-muted">{t("notFound.text")}</p>
    <p class="mt-1 text-muted" lang="en">
      {en("notFound.text")}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/" iconEnd="arrow-right">
        {t("notFound.home")}
      </Button>
      <Button href="/en/" variant="secondary" lang="en">
        {en("notFound.home")}
      </Button>
    </div>
  </Container>
</BaseLayout>
