---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/utils";

// Cloudflare Pages bulunamayan her adres için bu sayfayı 404 koduyla döner.
const t = useTranslations("tr");
const en = useTranslations("en");
---

<BaseLayout title={t("notFound.title")} noindex>
  <section class="mx-auto max-w-5xl px-4 py-28 sm:px-6">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 text-5xl">{t("notFound.title")}</h1>
    <p class="mt-4 text-muted">{t("notFound.text")}</p>
    <p class="mt-1 text-muted" lang="en">
      {en("notFound.text")}
    </p>
    <a href="/" class="mt-8 inline-block">
      {t("notFound.home")} →
    </a>
  </section>
</BaseLayout>
