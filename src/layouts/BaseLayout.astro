---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, getAlternatePath, useTranslations } from "../i18n/utils";
import { languages, type Lang } from "../i18n/ui";
import { contentSecurityPolicy } from "../security/csp";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Sayfanın diğer dilde karşılığı var mı? Yoksa (404, tasarım sayfası) dil bağlantısı ve hreflang gösterilmez. */
  translated?: boolean;
  /** Sade üst çubuk (yalnızca ana sayfa). */
  minimalHeader?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title,
  description = t("site.description"),
  noindex = false,
  translated = true,
  minimalHeader = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${t("site.title")}` : t("site.title");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale = lang === "tr" ? "tr_TR" : "en_US";
// Paylaşım görseli: og/ klasöründen `pnpm og` ile üretilir.
const ogImage = new URL(`/og-${lang}.png`, Astro.site).href;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(getAlternatePath(Astro.url, l), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- GitHub Pages HTTP başlığı desteklemediği için CSP ve Referrer-Policy meta etiketiyle verilir. -->
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {translated && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={t("site.title")} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("site.title")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a0f08" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!--
      Tema, sayfa çizilmeden önce uygulanmalı (yanıp sönmeyi önler).
      CSP satır içi script'e izin vermediği için harici dosya olarak yüklenir.
    -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="bg-grain flex min-h-dvh flex-col overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2"
    >
      {t("nav.skip")}
    </a>
    <Header lang={lang} showLangSwitch={translated} minimal={minimalHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
