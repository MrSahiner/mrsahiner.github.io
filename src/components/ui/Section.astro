---
import Container from "./Container.astro";

interface Props {
  id?: string;
  /** Başlığın üstündeki küçük etiket (ör. "01"). */
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { id, eyebrow, title, description, class: className } = Astro.props;
const headingId = id ? `${id}-baslik` : undefined;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={["scroll-mt-20 border-t border-border py-16 sm:py-24", className]}
>
  <Container>
    <header class="max-w-2xl">
      {eyebrow && <p class="font-mono text-xs tracking-widest text-muted uppercase">{eyebrow}</p>}
      <h2 id={headingId} class="mt-2 text-4xl sm:text-5xl">
        {title}
      </h2>
      {description && <p class="mt-4 text-lg text-muted">{description}</p>}
    </header>
    <div class="mt-10">
      <slot />
    </div>
  </Container>
</section>
