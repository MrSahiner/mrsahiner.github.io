---
// Durum rozeti (ör. "Fırsatlara açığım", "Geliştiriliyor"). Renkli nokta yalnızca süstür;
// anlam metindedir, bu yüzden renk körlüğünden etkilenmez.
type Tone = "accent" | "success" | "neutral";

interface Props {
  tone?: Tone;
  class?: string;
}

const { tone = "accent", class: className } = Astro.props;
const dots: Record<Tone, string> = {
  accent: "bg-accent",
  success: "bg-success",
  neutral: "bg-muted",
};
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted",
    className,
  ]}
>
  <span class:list={["size-2 rounded-full", dots[tone]]} aria-hidden="true"></span>
  <slot />
</span>
