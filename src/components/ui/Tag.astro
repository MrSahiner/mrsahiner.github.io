---
// Teknoloji etiketi (ör. "Next.js", "PostgreSQL").
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-md bg-accent-soft px-2 py-0.5 font-mono text-xs text-foreground",
    className,
  ]}
>
  <slot />
</span>
