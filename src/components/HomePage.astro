---
// Ana sayfa yalnızca bir "ön yüz": hero, freelance şeridi, dört gezinme kartı ve teknoloji şeridi.
// Ayrıntılar alt sayfalarda (Projeler, Hakkımda, Deneyim, İletişim).
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./home/Hero.astro";
import Bento from "./home/Bento.astro";
import TechMarquee from "./home/TechMarquee.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout minimalHeader>
  <div class="mx-auto flex w-full max-w-[1180px] flex-col justify-center px-6 py-10 md:py-14">
    <Hero lang={lang} />
    <Bento lang={lang} />
    <TechMarquee lang={lang} />
  </div>
</BaseLayout>

<script>
  import "../scripts/interactions";
</script>
