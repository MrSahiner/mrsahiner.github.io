---
// Proje detay sayfası: özet, teknik öne çıkanlar ve ekran görüntüleri.
// Proje adı, Projeler sayfasındaki vitrin başlığından akarak gelir.
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import { projects, type Project } from "../../data/projects";
import { useTranslations } from "../../i18n/utils";
import { pathFor } from "../../i18n/routes";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
  slug: Project["slug"];
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const p = projects.find((x) => x.slug === slug);
if (!p) throw new Error(`Proje bulunamadı: ${slug}`);
const mobileScreens = p.screens.filter((s) => s.kind === "mobile");
const desktopScreens = p.screens.filter((s) => s.kind === "desktop");

const titleTransition: Record<Project["slug"], string> = {
  kutligo: "[view-transition-name:proje-kutligo]",
  "coffee-go": "[view-transition-name:proje-coffee-go]",
};
---

<BaseLayout title={p.name} description={p.pitch[lang]}>
  <Container class="py-12 sm:py-20">
    <a
      href={pathFor("projects", lang)}
      class="group inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-wider text-muted uppercase no-underline hover:text-primary"
    >
      <Icon name="arrow-right" class="size-4 rotate-180 transition-transform group-hover:-translate-x-1" />
      {t("projects.back")}
    </a>

    <p class="mt-10 font-mono text-[11px] font-semibold tracking-wider text-primary uppercase">
      {p.meta[lang]}
    </p>
    <h1
      class:list={[
        "mt-3 text-[clamp(3rem,9vw,6rem)] leading-[0.95] tracking-[-0.03em]",
        titleTransition[p.slug],
      ]}
    >
      {p.name}
    </h1>
    <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1">
      <span class="size-2 animate-pulse rounded-full bg-accent" aria-hidden="true"></span>
      <span class="font-mono text-[11px] font-medium">{p.status[lang]}</span>
    </p>
    <p class="mt-6 max-w-2xl text-xl text-muted">{p.pitch[lang]}</p>

    <section class="mt-12 grid gap-4 sm:grid-cols-3" aria-label={t("projects.features")}>
      {p.features.map((f) => (
        <div class="rounded-card border border-border bg-surface p-5 shadow-card">
          <span class="grid size-9 place-items-center rounded-full bg-accent-soft text-primary">
            <Icon name={f.icon} class="size-4" />
          </span>
          <p class="mt-4 text-[15px] leading-[22px]">{f.text[lang]}</p>
        </div>
      ))}
    </section>

    <ul class="mt-8 flex flex-wrap gap-2" aria-label={t("projects.tags")}>
      {p.tags.map((tag) => (
        <li class="rounded border border-border bg-background px-2.5 py-1 font-mono text-[11px] font-medium">
          {tag}
        </li>
      ))}
    </ul>

    {p.sampleRepo && (
      <a
        href={p.sampleRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2.5 rounded-full border border-border bg-surface px-5 py-2.5 text-sm font-medium text-foreground no-underline shadow-card transition-colors hover:border-accent hover:text-primary"
      >
        <Icon name="github-mark" class="size-4" />
        {t("projects.sample")}
        <span class="sr-only">{t("newTab")}</span>
      </a>
    )}

    <section class="mt-16" aria-labelledby="one-cikanlar">
      <h2 id="one-cikanlar" class="text-[32px] text-foreground sm:text-[40px]">
        {t("projects.highlights")}
      </h2>
      <ol class="mt-6 grid gap-3 lg:grid-cols-2">
        {p.highlights.map((h, i) => (
          <li class="flex gap-4 rounded-card border border-border bg-surface p-5 shadow-card">
            <span class="font-mono text-[11px] font-semibold text-primary">
              {String(i + 1).padStart(2, "0")}
            </span>
            <p class="text-[15px] leading-[23px]">{h[lang]}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-16" aria-labelledby="ekranlar">
      <h2 id="ekranlar" class="text-[32px] text-foreground sm:text-[40px]">
        {t("projects.screens")}
      </h2>
      <p class="mt-2 text-sm text-muted">{t("projects.screensNote")}</p>

      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
        {mobileScreens.map((s) => (
          <figure>
            <a
              href={s.image.src}
              target="_blank"
              rel="noopener"
              class="block overflow-hidden rounded-[26px] border border-border bg-surface p-1.5 shadow-card"
            >
              <Image
                src={s.image}
                alt={s.caption[lang]}
                widths={[240, 360, 480, 720]}
                sizes="(min-width: 640px) 30vw, 45vw"
                class="h-auto w-full rounded-[20px]"
              />
            </a>
            <figcaption class="mt-3 text-sm leading-5 text-muted">{s.caption[lang]}</figcaption>
          </figure>
        ))}
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        {desktopScreens.map((s) => (
          <figure>
            <a
              href={s.image.src}
              target="_blank"
              rel="noopener"
              class="block overflow-hidden rounded-card border border-border bg-surface shadow-card"
            >
              <span class="flex gap-1.5 border-b border-border px-3 py-2" aria-hidden="true">
                <span class="size-2 rounded-full bg-border"></span>
                <span class="size-2 rounded-full bg-border"></span>
                <span class="size-2 rounded-full bg-border"></span>
              </span>
              <Image
                src={s.image}
                alt={s.caption[lang]}
                widths={[640, 960, 1280, 1920]}
                sizes="(min-width: 1024px) 560px, 100vw"
                class="h-auto w-full"
              />
            </a>
            <figcaption class="mt-3 text-sm leading-5 text-muted">{s.caption[lang]}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </Container>
</BaseLayout>
