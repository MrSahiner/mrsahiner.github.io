---
import { getAlternatePath, useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = lang === "tr" ? "/" : "/en/";
const otherLang: Lang = lang === "tr" ? "en" : "tr";
const links = [
  { href: `${home}#hakkimda`, label: t("nav.about") },
  { href: `${home}#projeler`, label: t("nav.projects") },
  { href: `${home}#deneyim`, label: t("nav.experience") },
  { href: `${home}#iletisim`, label: t("nav.contact") },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="font-heading text-2xl font-semibold text-foreground no-underline">
      MS<span class="text-accent">.</span>
    </a>

    <nav aria-label={t("nav.label")} class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm">
        {links.map((l) => (
          <li>
            <a href={l.href} class="text-muted no-underline hover:text-foreground">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={getAlternatePath(Astro.url, otherLang)}
        hreflang={otherLang}
        lang={otherLang}
        class="rounded-md px-2 py-1 text-sm text-muted no-underline hover:text-foreground"
      >
        {t("lang.switch")}
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t("theme.toggle")}
        title={t("theme.toggle")}
        class="grid size-9 place-items-center rounded-md border border-border text-muted hover:text-foreground"
      >
        <svg
          class="size-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg
          class="hidden size-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
