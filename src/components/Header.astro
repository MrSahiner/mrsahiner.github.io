---
import Icon from "./ui/Icon.astro";
import { getAlternatePath, useTranslations } from "../i18n/utils";
import { findRoute, pathFor } from "../i18n/routes";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  showLangSwitch?: boolean;
  /** Ana sayfada yalnızca monogram, dil ve tema; menü bağlantıları alt sayfalarda görünür. */
  minimal?: boolean;
}

const { lang, showLangSwitch = true, minimal = false } = Astro.props;
const t = useTranslations(lang);
const current = findRoute(Astro.url.pathname);
const otherLang: Lang = lang === "tr" ? "en" : "tr";
const links = (["projects", "about", "experience", "contact"] as const).map((key) => ({
  key,
  href: pathFor(key, lang),
  label: t(`nav.${key}`),
}));
---

<header class="relative z-40">
  <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 border-b border-border px-6 py-6">
    <a
      href={pathFor("home", lang)}
      class="group flex items-center gap-2 no-underline"
      aria-label={t("site.title")}
    >
      <span class="font-heading text-3xl font-semibold tracking-tight text-foreground transition-colors group-hover:text-primary">
        MS.
      </span>
      <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
    </a>

    {!minimal && (
      <nav aria-label={t("nav.label")} class="hidden md:block">
        <ul class="flex items-center gap-1 text-sm">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={current === l.key ? "page" : undefined}
                class="rounded-full px-3.5 py-1.5 text-muted no-underline transition-colors hover:text-foreground aria-[current=page]:bg-accent-soft aria-[current=page]:text-foreground"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="flex items-center gap-3">
      {showLangSwitch && (
        <a
          href={getAlternatePath(Astro.url, otherLang)}
          hreflang={otherLang}
          lang={otherLang}
          aria-label={t("lang.switchLabel")}
          class="flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 font-mono text-[11px] font-medium tracking-wide text-foreground no-underline transition-colors hover:border-accent hover:text-foreground"
        >
          <Icon name="globe" class="size-4 text-primary" />
          {t("lang.switch")}
        </a>
      )}
      <button
        type="button"
        data-theme-toggle
        aria-label={t("theme.toggle")}
        title={t("theme.toggle")}
        class="grid size-9 place-items-center rounded-full border border-border bg-surface text-foreground transition-colors hover:border-accent hover:text-primary"
      >
        <Icon name="sun" class="size-[18px] dark:hidden" />
        <Icon name="moon" class="hidden size-[18px] dark:block" />
      </button>
      {!minimal && (
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobil-menu"
          aria-label={t("nav.menu")}
          class="group grid size-9 place-items-center rounded-full border border-border bg-surface text-foreground hover:border-accent md:hidden"
        >
          <Icon name="menu" class="size-4 group-aria-expanded:hidden" />
          <Icon name="close" class="hidden size-4 group-aria-expanded:block" />
        </button>
      )}
    </div>
  </div>

  {!minimal && (
    <nav id="mobil-menu" aria-label={t("nav.label")} class="border-b border-border md:hidden" hidden>
      <ul class="mx-auto flex max-w-[1180px] flex-col px-6 py-2">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              data-menu-link
              aria-current={current === l.key ? "page" : undefined}
              class="block border-b border-border py-3 font-heading text-2xl text-foreground no-underline last:border-0 aria-[current=page]:text-primary"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</header>

<script>
  // Mobil menü: Astro bu script'i harici bir dosya olarak paketler (CSP satır içi script'e izin vermez).
  const button = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobil-menu");

  function setOpen(open: boolean) {
    if (!button || !menu) return;
    button.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
  }

  button?.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  menu
    ?.querySelectorAll("[data-menu-link]")
    .forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      button.focus();
    }
  });
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
