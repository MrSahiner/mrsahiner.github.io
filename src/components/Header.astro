---
import Icon from "./ui/Icon.astro";
import { getAlternatePath, useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  showLangSwitch?: boolean;
}

const { lang, showLangSwitch = true } = Astro.props;
const t = useTranslations(lang);
const home = lang === "tr" ? "/" : "/en/";
const otherLang: Lang = lang === "tr" ? "en" : "tr";
const links = [
  { href: `${home}#hakkimda`, label: t("nav.about") },
  { href: `${home}#projeler`, label: t("nav.projects") },
  { href: `${home}#deneyim`, label: t("nav.experience") },
  { href: `${home}#iletisim`, label: t("nav.contact") },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="font-heading text-2xl font-semibold text-foreground no-underline">
      MS<span class="text-accent">.</span>
    </a>

    <nav aria-label={t("nav.label")} class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm">
        {links.map((l) => (
          <li>
            <a href={l.href} class="text-muted no-underline hover:text-foreground">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {showLangSwitch && (
        <a
          href={getAlternatePath(Astro.url, otherLang)}
          hreflang={otherLang}
          lang={otherLang}
          class="rounded-md px-2 py-1 text-sm text-muted no-underline hover:text-foreground"
        >
          {t("lang.switch")}
        </a>
      )}
      <button
        type="button"
        data-theme-toggle
        aria-label={t("theme.toggle")}
        title={t("theme.toggle")}
        class="grid size-9 place-items-center rounded-md border border-border text-muted hover:text-foreground"
      >
        <Icon name="moon" class="size-4 dark:hidden" />
        <Icon name="sun" class="hidden size-4 dark:block" />
      </button>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobil-menu"
        aria-label={t("nav.menu")}
        class="group grid size-9 place-items-center rounded-md border border-border text-muted hover:text-foreground md:hidden"
      >
        <Icon name="menu" class="size-4 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-4 group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <nav id="mobil-menu" aria-label={t("nav.label")} class="border-t border-border md:hidden" hidden>
    <ul class="mx-auto flex max-w-5xl flex-col px-4 py-2 sm:px-6">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            data-menu-link
            class="block border-b border-border py-3 text-base text-foreground no-underline last:border-0"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Mobil menü: Astro bu script'i harici bir dosya olarak paketler (CSP satır içi script'e izin vermez).
  const button = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobil-menu");

  function setOpen(open: boolean) {
    if (!button || !menu) return;
    button.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
  }

  button?.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  menu
    ?.querySelectorAll("[data-menu-link]")
    .forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      button.focus();
    }
  });
  window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
