---
// Deneyim sayfası: yörünge yolu gibi kaydırdıkça çizilen altın zaman çizelgesi, özet kartları ve iletişim bandı.
// Çizgi ilerlemesi ve noktaların yanması src/scripts/experience.ts ile yapılır; script yoksa çizgi tam görünür.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import { experience, experienceInfo, type ExperienceEntry } from "../../data/experience";
import { useTranslations } from "../../i18n/utils";
import { pathFor } from "../../i18n/routes";
import type { Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const styles: Record<
  ExperienceEntry["variant"],
  { card: string; title: string; muted: string; label: string; tag: string; dot: string; rule: string }
> = {
  spotlight: {
    card: "border-spotlight-border bg-spotlight text-spotlight-foreground shadow-[0_24px_60px_-24px_var(--glow)]",
    title: "text-spotlight-foreground",
    muted: "text-spotlight-muted",
    label: "text-spotlight-accent",
    tag: "border-spotlight-border bg-spotlight-nested text-spotlight-muted",
    dot: "bg-accent",
    rule: "border-spotlight-border",
  },
  surface: {
    card: "border-border bg-surface text-foreground shadow-card hover:border-accent",
    title: "text-foreground",
    muted: "text-muted",
    label: "text-primary",
    tag: "border-border bg-accent-soft text-foreground",
    dot: "bg-accent",
    rule: "border-border",
  },
  soft: {
    card: "border-border bg-accent-soft text-foreground shadow-card",
    title: "text-foreground",
    muted: "text-muted",
    label: "text-foreground",
    tag: "border-border bg-surface text-foreground",
    dot: "bg-primary",
    rule: "border-border",
  },
};
---

<BaseLayout title={t("nav.experience")} description={t("experience.intro")}>
  <Container class="space-y-12 py-10 md:space-y-16 md:py-14">
    <section class="border-b border-border pb-8 md:pb-10">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="mb-3 font-mono text-[11px] font-semibold tracking-widest text-primary uppercase">
            {t("bento.experience.eyebrow")}
          </p>
          <h1 class="mb-4 text-[clamp(3rem,9vw,6rem)] leading-[0.95] tracking-[-0.03em] [view-transition-name:baslik-experience]">
            {t("nav.experience")}
          </h1>
          <p class="text-lg text-pretty text-muted">{t("experience.intro")}</p>
        </div>

        <svg
          class="pointer-events-none hidden h-36 w-64 shrink-0 overflow-visible md:block"
          viewBox="0 0 256 144"
          fill="none"
          aria-hidden="true"
        >
          <ellipse
            class="stroke-accent opacity-70"
            cx="148"
            cy="54"
            rx="88"
            ry="34"
            transform="rotate(-14 148 54)"
            stroke-width="1"
            stroke-dasharray="4 6"
          ></ellipse>
          <ellipse
            class="stroke-accent opacity-45"
            cx="148"
            cy="54"
            rx="54"
            ry="20"
            transform="rotate(-14 148 54)"
            stroke-width="1"
          ></ellipse>
          <g class="header-spin">
            <circle class="fill-accent" cx="226" cy="36" r="4"></circle>
            <circle class="fill-primary" cx="72" cy="70" r="3"></circle>
          </g>
          <path
            class="header-path stroke-accent opacity-80"
            d="M 148 74 C 148 118, 36 108, 12 144"
            stroke-width="1.25"
            stroke-dasharray="3 4"
          ></path>
          <circle class="fill-accent" cx="148" cy="74" r="2.5"></circle>
        </svg>
      </div>
    </section>

    <!-- Zaman çizelgesi -->
    <section class="relative" aria-label={t("experience.timeline")} data-timeline>
      <div class="pointer-events-none absolute top-0 bottom-0 left-3 w-px md:left-[26%]" aria-hidden="true">
        <div class="absolute inset-0 bg-accent/20"></div>
        <div class="timeline-progress absolute inset-0 origin-top bg-accent"></div>
        <div class="absolute top-8 bottom-8 -left-1.5 hidden border-l border-dashed border-accent/30 md:block"></div>
      </div>

      <ol class="space-y-10 md:space-y-12">
        {experience.map((e) => {
          const s = styles[e.variant];
          return (
            <li class="reveal relative grid grid-cols-1 items-start gap-4 pl-10 md:grid-cols-12 md:gap-8 md:pl-0">
              <div class="hidden pt-1 md:col-span-3 md:block md:pr-8 md:text-right">
                <p class="font-mono text-[11px] font-semibold tracking-wider text-primary uppercase">
                  {e.date[lang]}
                </p>
                <p class="mt-1 text-[13px] text-muted">{e.note[lang]}</p>
              </div>

              <span
                class="timeline-dot absolute top-2 left-3 grid size-5 -translate-x-1/2 place-items-center rounded-full border border-accent/60 bg-background md:left-[26%]"
                data-timeline-dot
                aria-hidden="true"
              >
                <span class:list={["size-2.5 rounded-full", s.dot]} />
              </span>

              <article
                class:list={[
                  "rounded-card border p-6 transition-colors md:col-span-9 md:ml-6 md:p-8",
                  s.card,
                ]}
                aria-labelledby={`deneyim-${e.id}`}
              >
                <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
                  <p
                    class:list={[
                      "font-mono text-[11px] font-semibold tracking-widest uppercase md:hidden",
                      s.label,
                    ]}
                  >
                    {e.date[lang]}
                  </p>
                  {e.badge && (
                    <p class="inline-flex items-center gap-2 rounded-full border border-spotlight-border bg-spotlight-nested px-3 py-1 text-xs md:ml-auto">
                      <span class="size-1.5 animate-pulse rounded-full bg-accent" aria-hidden="true" />
                      {e.badge[lang]}
                    </p>
                  )}
                </div>

                <h2 id={`deneyim-${e.id}`} class:list={["text-[28px] md:text-4xl", s.title]}>
                  {e.title[lang]}
                </h2>
                <p class:list={["mt-1 mb-5 text-base font-medium", s.muted]}>{e.role[lang]}</p>

                {e.bullets.length > 0 && (
                  <ul
                    class:list={[
                      "mb-6 space-y-2.5 text-[15px] leading-[22px]",
                      e.variant === "spotlight" && s.muted,
                    ]}
                  >
                    {e.bullets.map((b) => (
                      <li class="flex items-start gap-3">
                        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                        <span class="text-pretty">{b[lang]}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {e.text && <p class="text-[15px] leading-[22px] text-pretty">{e.text[lang]}</p>}

                {e.links && (
                  <div class="mb-6 flex flex-wrap items-center gap-2.5">
                    {e.links.map((l) => (
                      <a
                        href={pathFor(l.route, lang)}
                        class="group inline-flex items-center gap-1.5 rounded-full border border-spotlight-border bg-spotlight-nested px-3.5 py-1.5 text-xs font-medium text-spotlight-foreground no-underline transition-colors hover:border-accent hover:text-spotlight-accent"
                      >
                        {l.label}
                        <Icon
                          name="arrow-right"
                          class="size-3.5 transition-transform group-hover:translate-x-0.5"
                        />
                      </a>
                    ))}
                  </div>
                )}

                {e.tags.length > 0 && (
                  <ul
                    class:list={["flex flex-wrap items-center gap-2 border-t pt-4", s.rule]}
                    aria-label={t("projects.tags")}
                  >
                    {e.tags.map((tag) => (
                      <li class:list={["rounded-md border px-2.5 py-1 font-mono text-[11px]", s.tag]}>
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- Özet -->
    <section aria-label={t("experience.summary")}>
      <dl class="reveal-stagger grid grid-cols-1 gap-4 md:grid-cols-3">
        {experienceInfo.map((i) => (
          <div class="flex flex-col justify-between gap-2 rounded-card border border-border bg-surface p-5 shadow-card">
            <dt class="font-mono text-[11px] font-semibold tracking-wider text-muted uppercase">
              {i.label[lang]}
            </dt>
            <dd class="flex items-center gap-2.5 text-base font-semibold">
              {i.dot && (
                <span class="size-2 shrink-0 animate-pulse rounded-full bg-accent" aria-hidden="true" />
              )}
              {i.value[lang]}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- İletişim bandı -->
    <section class="reveal flex flex-col justify-between gap-6 rounded-card border border-border bg-accent-soft p-8 md:flex-row md:items-center md:p-10">
      <div class="max-w-xl space-y-2">
        <h2 class="text-[28px] md:text-4xl">{t("bento.contact.title")}</h2>
        <p class="text-[15px] text-pretty text-muted">{t("experience.cta")}</p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <a
          href={pathFor("contact", lang)}
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-medium text-primary-foreground no-underline shadow-card transition-colors hover:bg-primary-hover hover:text-primary-foreground"
        >
          {t("projects.roadmap.contact")}
        </a>
        <a
          href={pathFor("projects", lang)}
          class="group inline-flex items-center gap-2 rounded-full border border-border bg-surface px-5 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:border-accent hover:text-primary"
        >
          {t("experience.seeProjects")}
          <Icon name="arrow-right" class="size-[18px] transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </section>
  </Container>
</BaseLayout>

<script>
  import "../../scripts/experience";
</script>

<style>
  /* Altın çizgi kaydırdıkça çizilir: --progress (0–1) experience.ts'ten gelir; script yoksa tam görünür. */
  .timeline-progress {
    scale: 1 var(--progress, 1);
    transition: scale 0.25s linear;
  }
  /* Çizgi bir noktaya ulaşınca nokta yanar. */
  .timeline-dot {
    transition:
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }
  :global(.timeline-dot.is-reached) {
    border-color: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .header-spin {
    transform-origin: 148px 54px;
    animation: header-spin 28s linear infinite;
  }
  @keyframes header-spin {
    to {
      rotate: 360deg;
    }
  }
  .header-path {
    animation: dash 3s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -14;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-spin,
    .header-path {
      animation: none;
    }
    .timeline-progress {
      scale: 1 1;
    }
  }
</style>
